{
  "manifest_version": 3,
  "name": "Gsou DMIT 同步",
  "short_name": "Gsou DMIT",
  "version": "1.0.0",
  "description": "在您已登录的 DMIT 客户中心页面中读取服务器名称、IP、流量与到期信息，并通过本机原生连接同步给 Gsou 应用。不读取密码、Cookie 或验证令牌。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "storage", "alarms", "tabs"],
  "host_permissions": ["https://www.dmit.io/*"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Gsou DMIT 同步",
    "default_popup": "popup/popup.html"
  }
}

